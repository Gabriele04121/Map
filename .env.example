# Copy to .env (git-ignored) and fill what you need. Everything is optional: without keys the app runs on
# bundled data, free keyless APIs and clearly-labelled MOCK data.

# --- server -------------------------------------------------------------------------
TRAVELOS_HOST=127.0.0.1          # keep on localhost: the API has no authentication
TRAVELOS_PORT=8765
TRAVELOS_LOG_LEVEL=INFO
# TRAVELOS_DB=data/travelos.db
# TRAVELOS_ALLOWED_HOSTS=localhost,127.0.0.1

# --- behaviour ----------------------------------------------------------------------
TRAVELOS_ENABLE_MOCK=1           # 1 = synthetic MOCK flights/trains when no real provider answers (always badged). 0 = never.
TRAVELOS_OFFLINE=0               # 1 = never touch the network (cache + bundled data only)
TRAVELOS_MONITOR=1               # background price-watch refresher
TRAVELOS_MONITOR_INTERVAL=1800   # seconds between refresher wake-ups (watches themselves re-check at most every 6 h)
TRAVELOS_HTTP_TIMEOUT=12
TRAVELOS_HTTP_RETRIES=2
# Some free services (Transitous, Nominatim...) ask for a contact in the User-Agent. Optional, sent only in the UA header.
TRAVELOS_CONTACT_EMAIL=

# --- API keys (never commit real values) --------------------------------------------
# Flights: Travelpayouts / Aviasales Data API. Free: register at https://www.travelpayouts.com -> API token.
TRAVELPAYOUTS_TOKEN=
